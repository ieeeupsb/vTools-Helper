{
  "_metadata": {
    "author": "Gil Ben Ami",
    "repository": "https://github.com/GBAS-BCN/vTools-Helper",
    "license": "GPL-3.0"
  },
  "manifest_version": 3,
  "name": "vTools IEEE Event Autofill Assistant",
  "version": "6.1.3",
  "description": "Configurable autofill assistant for IEEE vTools events.",
  "permissions": [
	"storage",
    "scripting",
    "activeTab"
  ],
  "action": {
    "default_title": "Open vTools Create Event"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://events.vtools.ieee.org/tego_/event/*"],
      "js": ["src/md-import.js", "src/content.js"],
      "css": ["src/styles.css"]
    }
  ]
}
